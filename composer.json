{
    "name": "paygate/module-instant-payment",
    "description": "Instant approval card payments (Visa, Mastercard, Amex, Apple Pay, Google Pay and more) for Magento 2 with instant payouts to your own USDC wallet. No KYC, no merchant account.",
    "type": "magento2-module",
    "license": "GPL-3.0-or-later",
    "homepage": "https://paygate.to/instant-payment-gateway/",
    "keywords": ["magento", "magento2", "adobe-commerce", "mage-os", "payment", "credit-card", "high-risk", "no-kyc", "paygate"],
    "require": {
        "php": "~7.4.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "magento/framework": "^103.0",
        "magento/module-backend": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-payment": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "PayGate\\InstantPayment\\": ""
        }
    }
}
